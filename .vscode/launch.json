{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Fast JSON Viewer Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "fast-json-viewer: build"
    }
  ]
}
